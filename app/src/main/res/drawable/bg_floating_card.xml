<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ nổi trên sơ đồ kiểu sticker (Q42): bảng chú thích, thẻ giá, dòng "Đang lọc", thông báo M7. Nền kem, viền tím 3dp, bo góc 20dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke
        android:width="3dp"
        android:color="@color/sticker_outline" />
    <corners android:radius="20dp" />
</shape>
