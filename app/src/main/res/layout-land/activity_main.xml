<?xml version="1.0" encoding="utf-8"?>
<!--
    Bố cục ngang (Q36, Q51, Q52): cột trái rộng 320dp (panel 304dp) gồm panel lọc ở trên và bảng chi tiết ở đáy; sơ đồ
    bên phải cao trọn màn hình nên không phải chừa chỗ cho bảng. Máy ngang ít chiều cao, nên các control lọc xếp dọc
    trong panel (cuộn được) thay vì nằm ngang trên đầu như bản dọc; riêng dòng "Đang lọc" là thẻ nổi trên sơ đồ như bản
    dọc. Các lớp của sơ đồ và bảng chi tiết dùng chung với bản dọc qua include; id giống hệt nên FilterBar và DetailSheet
    không cần biết hướng màn hình.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- Nền poster hồng sen với dải lỏng chuyển động (Q42, Q43): nằm dưới cùng, mọi lớp khác vẽ đè lên. -->
    <com.example.midtermproject.decor.LiquidPosterView
        android:id="@+id/poster_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cột nội dung: panel lọc rồi khung chứa sơ đồ. Lề hệ thống được áp vào đây (xem bản dọc). -->
    <LinearLayout
        android:id="@+id/content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="horizontal">

        <!--
            Cột trái. Là một CoordinatorLayout riêng để bảng chi tiết (BottomSheetBehavior) nằm gọn trong cột: thu gọn ở
            đáy cột, mở rộng thì phủ lên panel lọc chứ không phủ sơ đồ.
        -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/side_column"
            android:layout_width="@dimen/side_column_width"
            android:layout_height="match_parent">

            <!-- Tên "Gieo" rồi panel lọc, xếp dọc; bảng chi tiết nằm đè ở đáy cột (Q51). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!--
                    Tên đêm nhạc "Gieo" (Q49) nằm trên nền poster, ngoài panel lọc, cùng vị trí như bản dọc (Q53): chữ rơi
                    xuống khi mở app rồi lắc lư chậm.
                -->
                <com.example.midtermproject.decor.ConcertTitleView
                    android:id="@+id/concert_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp" />

                <!--
                    Panel lọc: một miếng sticker kem viền tím nổi trên nền poster, cuộn được vì máy ngang ít chiều cao. Lề dưới
                    được MainActivity đặt bằng chiều cao bảng chi tiết thu gọn, nên panel kết thúc ngay trên bảng. Đệm dưới 8dp để
                    phần đang cuộn bị cắt phía trong viền, không vẽ đè lên viền.
                -->
                <ScrollView
                    android:id="@+id/filter_panel"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_margin="@dimen/sticker_margin"
                    android:background="@drawable/bg_sticker_panel"
                    android:fillViewport="true"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider_vertical_8dp"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <include
                            android:id="@+id/filter_bar"
                            layout="@layout/view_filter_bar" />

                        <!-- Các control giá hiện sẵn, không có nút Giá và không có thẻ nổi. -->
                        <LinearLayout
                            android:id="@+id/card_price_filter"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include layout="@layout/view_price_controls" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <!--
                Bảng chi tiết ở máy ngang (Q51, AC-7.2): rộng bằng cột trái, nằm ở đáy cột ngay dưới panel lọc. Khi include
                ghi đè layout_*, LayoutParams được dựng lại chỉ từ các thuộc tính trên include, nên layout_behavior của bảng
                phải được khai báo lại ở đây, không thì BottomSheetBehavior.from báo lỗi.
            -->
            <include
                layout="@layout/view_bottom_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sticker_margin"
                android:layout_marginEnd="@dimen/sticker_margin"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" />
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false">

            <include layout="@layout/view_map_layers" />

            <!--
                Dòng "Đang lọc" kèm nút Xóa lọc (AC-4.6): thẻ nổi ở đầu sơ đồ, bên trong viền sticker, chừa chỗ bên phải cho cột
                nút, giống bản dọc (Q52). Panel lọc bên trái thấp vì chừa chỗ cho bảng chi tiết, nên nếu đặt trong panel thì
                dòng này bị đẩy khuất. Ẩn khi mọi tiêu chí đều mặc định.
            -->
            <LinearLayout
                android:id="@+id/layout_filter_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="@dimen/sticker_content_margin"
                android:layout_marginTop="@dimen/sticker_content_margin"
                android:layout_marginEnd="@dimen/sticker_overlay_end_margin"
                android:background="@drawable/bg_floating_card"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <include layout="@layout/view_filter_status" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
