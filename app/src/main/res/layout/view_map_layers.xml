<?xml version="1.0" encoding="utf-8"?>
<!--
    Các lớp của khung chứa sơ đồ dùng chung cho bố cục dọc và ngang: sơ đồ, thông báo không có kết quả, cột nút nổi
    và bảng chú thích. Là <merge>: các lớp được thêm thẳng vào FrameLayout map_container của nơi include.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!--
        Toàn bộ sơ đồ được vẽ trên đúng một View này (yêu cầu bắt buộc của đề). Lùi vào 16dp ở ba cạnh để mép sơ đồ
        nằm khuất dưới viền sticker; cạnh dưới vẫn kéo xuống dưới bảng chi tiết như trước.
    -->
    <com.example.midtermproject.map.VenueMapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/sticker_map_inset"
        android:layout_marginTop="@dimen/sticker_map_inset"
        android:layout_marginEnd="@dimen/sticker_map_inset" />

    <!--
        Viền sticker cam đè lên mép sơ đồ. Cạnh dưới của viền nằm khuất sau bảng chi tiết, như
        miếng dán bị miếng khác dán chồng lên. Chạm lên viền không lọt xuống sơ đồ.
    -->
    <com.example.midtermproject.decor.StickerFrameView
        android:id="@+id/sticker_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Thông báo M7 khi bộ lọc không khớp chỗ nào (AC-4.7): thẻ ở giữa vùng sơ đồ, kèm nút Xóa lọc. Lề dưới được
        code cộng thêm chiều cao bảng chi tiết đang thu gọn để thẻ nằm giữa phần sơ đồ nhìn thấy được.
    -->
    <LinearLayout
        android:id="@+id/layout_no_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_floating_card"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_no_match"
            android:textColor="@color/sheet_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_filter_no_result"
            style="@style/Widget.MidtermProject.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/filter_clear" />
    </LinearLayout>

    <!-- Cột nút nổi góc trên phải sơ đồ, xếp dọc và cách nhau 8dp: bảng chú thích, Reset View, la bàn (chỉ hiện khi lệch góc). -->
    <LinearLayout
        android:id="@+id/map_button_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/sticker_content_margin"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btn_legend"
            android:stateListAnimator="@animator/press_bounce"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_map_button"
            android:contentDescription="@string/legend_show_description"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info" />

        <ImageButton
            android:id="@+id/btn_reset_view"
            android:stateListAnimator="@animator/press_bounce"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_map_button"
            android:contentDescription="@string/reset_view_content_description"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_reset_view" />

        <!-- Kim la bàn luôn chỉ về phía sân khấu. -->
        <ImageButton
            android:id="@+id/btn_compass"
            android:stateListAnimator="@animator/press_bounce"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_map_button"
            android:contentDescription="@string/compass_content_description"
            android:elevation="4dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_compass"
            android:visibility="gone" />
    </LinearLayout>

    <!--
        Bảng chú thích: các mục được thêm bằng code (LegendCard). Mặc định ẩn. Lề dưới được code cộng thêm
        chiều cao bảng chi tiết đang thu gọn, vì khung chứa sơ đồ kéo dài xuống dưới bảng.
        clickable để thẻ nhận chạm: không thì chạm lên thẻ lọt xuống sơ đồ và chọn nhầm chỗ nằm bên dưới.
    -->
    <GridLayout
        android:id="@+id/card_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/sticker_content_margin"
        android:background="@drawable/bg_floating_card"
        android:clickable="true"
        android:columnCount="@integer/legend_columns"
        android:elevation="4dp"
        android:focusable="false"
        android:padding="@dimen/legend_card_padding"
        android:visibility="gone" />
</merge>
