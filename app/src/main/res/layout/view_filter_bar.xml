<?xml version="1.0" encoding="utf-8"?>
<!--
    Thanh lọc ở đầu màn hình dọc: ô tìm kiếm rồi một hàng chip khu. Các id ở đây là chỗ FilterBar tìm control;
    bố cục ngang (layout-land) dùng lại cùng id nhưng xếp thành panel bên trái.
    Thanh nhận focus được (beforeDescendants): FilterBar chuyển focus về đây khi ô tìm kiếm xong việc, để ô đó
    thật sự bỏ focus (xem FilterBar.bindSearch).
    Tắt highlight focus mặc định, nếu không cả thanh bị phủ một lớp xám khi nó đang giữ focus.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:defaultFocusHighlightEnabled="false"
    android:descendantFocusability="beforeDescendants"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp"
    tools:targetApi="o">

    <!-- Có nút xóa (endIconMode); lọc ngay mỗi lần gõ, không cần bấm tìm (AC-4.2). -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_search"
        style="@style/Widget.MidtermProject.SearchField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_search"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="textNoSuggestions"
            android:maxLength="20"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textColor="@color/sheet_text"
            android:textColorHint="@color/sticker_outline"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Hàng chip: bốn chip khu trượt ngang được (máy hẹp không bị cắt chữ), nút Giá luôn nằm cuối hàng. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadingEdgeLength="16dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_zone"
                android:saveEnabled="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/filter_zone_group_description"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_zone_all"
                    android:saveEnabled="false"
                    style="@style/Widget.MidtermProject.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_zone_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_zone_standing"
                    android:saveEnabled="false"
                    style="@style/Widget.MidtermProject.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_standing" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_zone_vip"
                    android:saveEnabled="false"
                    style="@style/Widget.MidtermProject.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_vip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_zone_standard"
                    android:saveEnabled="false"
                    style="@style/Widget.MidtermProject.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zone_standard" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Mở và đóng thẻ "Chỉ chỗ trống, khoảng giá" nổi trên sơ đồ (Q26, Q37). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_filter_advanced"
            style="@style/Widget.MidtermProject.Button.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/filter_price_button"
            app:icon="@drawable/ic_tune" />
    </LinearLayout>
</LinearLayout>
