<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!--
        Cột nội dung: thanh lọc rồi khung chứa sơ đồ. Lề thanh trạng thái được áp vào đây chứ không phải vào
        CoordinatorLayout: CoordinatorLayout có padding thì BottomSheetBehavior đặt bảng thấp hơn tính toán
        đúng bằng padding đó. Khung chứa sơ đồ kéo dài xuống dưới bảng chi tiết.
    -->
    <LinearLayout
        android:id="@+id/content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/filter_bar"
            layout="@layout/view_filter_bar" />

        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Toàn bộ sơ đồ được vẽ trên đúng một View này (yêu cầu bắt buộc của đề). -->
            <com.example.midtermproject.map.VenueMapView
                android:id="@+id/map_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!--
                Các thẻ nổi ở phía trên sơ đồ, chừa 72dp bên phải cho cột nút. Thẻ nổi đè lên sơ đồ chứ không đẩy
                sơ đồ xuống, vì sơ đồ đổi kích thước thì tự về mức vừa khít và mất chỗ đang phóng to (Q37).
                LinearLayout này không nhận chạm; chỉ từng thẻ bên trong (clickable) mới chặn chạm không lọt xuống sơ đồ.
            -->
            <LinearLayout
                android:id="@+id/map_top_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="72dp"
                android:divider="@drawable/divider_vertical_8dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <!-- Thẻ "Chỉ chỗ trống" và khoảng giá; dùng chung nền thẻ nổi với bảng chú thích. Mặc định ẩn. -->
                <LinearLayout
                    android:id="@+id/card_price_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_legend_card"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="false"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_available_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/filter_available_only"
                        android:textColor="@color/sheet_text"
                        android:textSize="14sp"
                        android:theme="@style/ThemeOverlay.MidtermProject.InkSwitch" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_price_title"
                            android:textColor="@color/sheet_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_price_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/sheet_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Hai đầu, bước và giá trị ban đầu được code đặt từ SpotFilter.PRICE_MIN/PRICE_MAX để chỉ có một nguồn. -->
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/range_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/filter_price_slider_description"
                        app:tickVisible="false" />
                </LinearLayout>

                <!--
                    Dòng "Đang lọc" kèm nút Xóa lọc (AC-4.6). Nằm dưới thẻ giá để khi nó hiện ra lúc nhấc tay khỏi thanh giá
                    thì thanh giá không bị đẩy đi. Ẩn khi mọi tiêu chí đều mặc định.
                -->
                <LinearLayout
                    android:id="@+id/layout_filter_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_legend_card"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_filter_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityLiveRegion="polite"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/sheet_text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_clear_filter"
                        style="@style/Widget.MidtermProject.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_clear" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cột nút nổi góc trên phải sơ đồ, xếp dọc và cách nhau 8dp: bảng chú thích, Reset View, rồi la bàn (chỉ hiện khi lệch góc). -->
            <LinearLayout
                android:id="@+id/map_button_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btn_legend"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_map_button"
                    android:contentDescription="@string/legend_show_description"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info" />

                <ImageButton
                    android:id="@+id/btn_reset_view"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_map_button"
                    android:contentDescription="@string/reset_view_content_description"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_reset_view" />

                <!-- Kim la bàn luôn chỉ về phía sân khấu. -->
                <ImageButton
                    android:id="@+id/btn_compass"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_map_button"
                    android:contentDescription="@string/compass_content_description"
                    android:elevation="4dp"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_compass"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
                Bảng chú thích: các mục được thêm bằng code (LegendCard). Mặc định ẩn. Lề dưới được code cộng thêm
                chiều cao bảng chi tiết đang thu gọn, vì khung chứa sơ đồ kéo dài xuống dưới bảng.
            -->
            <GridLayout
                android:id="@+id/card_legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="12dp"
                android:background="@drawable/bg_legend_card"
                android:columnCount="@integer/legend_columns"
                android:elevation="4dp"
                android:padding="8dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!--
        Bảng chi tiết: luôn hiện ở dạng thu gọn (không ẩn được), kéo lên hoặc bấm phần đầu để mở rộng.
        Không đặt layout_gravity: BottomSheetBehavior tự dịch bảng xuống đáy, thêm gravity sẽ đẩy bảng ra ngoài màn hình.
        Phần đầu có chiều cao cố định (mỗi dòng chỉ một dòng chữ) nên peekHeight không đổi theo nội dung.
    -->
    <LinearLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        app:behavior_fitToContents="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="96dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:id="@+id/sheet_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_sheet_handle"
                android:importantForAccessibility="no" />

            <!-- Cao tối thiểu cố định: chip hiện hay ẩn cũng không làm đổi chiều cao phần đầu (peekHeight). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_focus_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/sheet_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_focus_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_state_chip"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_selection_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sheet_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Danh sách chỗ đang chọn và vé của bạn; cuộn được khi dài hơn phần bảng cho phép (AC-5.2). -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_spots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="ifContentScrolls" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
