<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <!-- Nền poster hồng sen với dải lỏng chuyển động (Q42, Q43): nằm dưới cùng, mọi lớp khác vẽ đè lên. -->
    <com.example.midtermproject.decor.LiquidPosterView
        android:id="@+id/poster_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
        Cột nội dung: thanh lọc rồi khung chứa sơ đồ. clipChildren=false ở đây và ở khung chứa sơ đồ để bóng đổ
        (elevation) của các nút và thẻ nổi không bị cắt phẳng ở mép khung. Lề thanh trạng thái được áp vào đây chứ không phải vào
        CoordinatorLayout: CoordinatorLayout có padding thì BottomSheetBehavior đặt bảng thấp hơn tính toán
        đúng bằng padding đó. Khung chứa sơ đồ kéo dài xuống dưới bảng chi tiết.
    -->
    <LinearLayout
        android:id="@+id/content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <include
            android:id="@+id/filter_bar"
            layout="@layout/view_filter_bar" />

        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <!-- Sơ đồ, thông báo không có kết quả, cột nút nổi và bảng chú thích (dùng chung với bố cục ngang). -->
            <include layout="@layout/view_map_layers" />

            <!--
                Các thẻ nổi ở phía trên sơ đồ, chừa 72dp bên phải cho cột nút. Thẻ nổi đè lên sơ đồ chứ không đẩy
                sơ đồ xuống, vì sơ đồ đổi kích thước thì tự về mức vừa khít và mất chỗ đang phóng to (Q37).
                LinearLayout này không nhận chạm; chỉ từng thẻ bên trong (clickable) mới chặn chạm không lọt xuống sơ đồ.
            -->
            <LinearLayout
                android:id="@+id/map_top_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="72dp"
                android:divider="@drawable/divider_vertical_8dp"
                android:orientation="vertical"
                android:showDividers="middle">

                <!-- Thẻ "Chỉ chỗ trống" và khoảng giá. Mặc định ẩn. -->
                <LinearLayout
                    android:id="@+id/card_price_filter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_floating_card"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="false"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <include layout="@layout/view_price_controls" />
                </LinearLayout>

                <!--
                    Dòng "Đang lọc" kèm nút Xóa lọc (AC-4.6). Nằm dưới thẻ giá để khi nó hiện ra lúc nhấc tay khỏi thanh giá
                    thì thanh giá không bị đẩy đi. Ẩn khi mọi tiêu chí đều mặc định.
                -->
                <LinearLayout
                    android:id="@+id/layout_filter_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_floating_card"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone">

                    <include layout="@layout/view_filter_status" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bảng chi tiết: xem view_bottom_sheet.xml. -->
    <include layout="@layout/view_bottom_sheet" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
