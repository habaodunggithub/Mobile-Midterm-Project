<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Giao diện sáng "Poster lỏng" (Q42), không có thanh tiêu đề; chỉ dùng chế độ sáng (REQUIREMENTS Q19). -->
    <style name="Theme.MidtermProject" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/spot_selected</item>
        <item name="colorOnPrimary">@color/on_spot_selected</item>
        <item name="colorSecondary">@color/zone_vip</item>
        <item name="colorOnSecondary">@color/on_zone_vip</item>
        <item name="android:windowBackground">@color/poster_background</item>
        <!-- Vẽ tràn xuống dưới thanh hệ thống (bắt buộc từ Android 15); Activity tự chừa lề bằng insets. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Biểu tượng thanh trạng thái màu sáng, vì nằm trên nền poster hồng sen. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MidtermProject.MaterialAlertDialog</item>
    </style>

    <!-- Hộp thoại xác nhận: nút "Hủy" và "Xác nhận" viết chữ thường như các nút khác trong app (Q41). -->
    <style name="ThemeOverlay.MidtermProject.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MidtermProject.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MidtermProject.Button.Dialog</item>
    </style>

    <style name="Widget.MidtermProject.Button.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
        Chip lọc khu: chọn một trong bốn; bỏ dấu tick vì nền tím đã đủ báo đang chọn. Kiểu sticker (Q42): nền kem,
        viền tím dày 3dp, chữ đậm. Vùng chạm vẫn 48dp (mặc định của Chip).
    -->
    <style name="Widget.MidtermProject.Chip.Filter" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textAppearance">@style/TextAppearance.MidtermProject.Sticker</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">3dp</item>
        <item name="chipStrokeColor">@color/sticker_outline</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="android:stateListAnimator">@animator/press_bounce</item>
    </style>

    <!-- Ô tìm kiếm dạng sticker viên thuốc: nền kem, viền tím dày 3dp, đổi sang mực khi đang gõ. Gợi ý nằm trong ô. -->
    <style name="Widget.MidtermProject.SearchField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">24dp</item>
        <item name="boxCornerRadiusTopEnd">24dp</item>
        <item name="boxCornerRadiusBottomStart">24dp</item>
        <item name="boxCornerRadiusBottomEnd">24dp</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">3dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="startIconTint">@color/sheet_text_secondary</item>
        <item name="endIconTint">@color/sheet_text_secondary</item>
    </style>

    <!-- Nút "Giá": giống chip lọc (sticker kem viền tím, tím khi đang mở) nhưng bật tắt riêng, không thuộc nhóm chọn một. -->
    <style name="Widget.MidtermProject.Button.Filter" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:checkable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/chip_filter_background</item>
        <item name="iconTint">@color/chip_filter_text</item>
        <item name="strokeColor">@color/sticker_outline</item>
        <item name="strokeWidth">3dp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:stateListAnimator">@animator/press_bounce</item>
    </style>

    <!-- Chữ đậm trên chip và nút kiểu sticker. -->
    <style name="TextAppearance.MidtermProject.Sticker" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nút chữ trong thẻ nổi ("Xóa lọc"): màu mực theo colorPrimary, chữ thường, vùng chạm cao 48dp. -->
    <style name="Widget.MidtermProject.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        Nút "Đặt N vé": nút đặc màu mực (colorPrimary), chữ thường bằng chữ lượn Kablammo, vì đây là một trong hai chỗ
        chữ to của màn hình (Q44). Vùng chạm cao 48dp, phần nhìn thấy thấp hơn nhờ inset của Material.
    -->
    <style name="Widget.MidtermProject.Button.Book" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/kablammo</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:stateListAnimator">@animator/press_bounce</item>
    </style>

    <!--
        Viên thuốc tóm tắt (Q47): sticker tím viền cam dày 4dp, chữ kem đậm. Cao 52dp (vùng chạm đủ 48dp), không có inset
        trên dưới của Material để viền bám sát chữ.
    -->
    <style name="Widget.MidtermProject.Button.Pill" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/surface</item>
        <item name="backgroundTint">@color/liquid_violet</item>
        <item name="iconTint">@color/surface</item>
        <item name="iconPadding">6dp</item>
        <item name="strokeColor">@color/sticker_band</item>
        <item name="strokeWidth">4dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:stateListAnimator">@animator/press_bounce</item>
    </style>

    <!-- Công tắc màu mực: màu phụ của giao diện là tím VIP, dễ nhầm với khu VIP. -->
    <style name="ThemeOverlay.MidtermProject.InkSwitch" parent="">
        <item name="colorSecondary">@color/spot_selected</item>
    </style>
</resources>
