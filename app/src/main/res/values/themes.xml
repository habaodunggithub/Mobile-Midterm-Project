<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Giao diện sáng, không có thanh tiêu đề; chỉ dùng chế độ sáng (REQUIREMENTS Q19). -->
    <style name="Theme.MidtermProject" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/spot_selected</item>
        <item name="colorOnPrimary">@color/on_spot_selected</item>
        <item name="colorSecondary">@color/zone_vip</item>
        <item name="colorOnSecondary">@color/on_zone_vip</item>
        <item name="android:windowBackground">@color/map_background</item>
        <!-- Vẽ tràn xuống dưới thanh hệ thống (bắt buộc từ Android 15); Activity tự chừa lề bằng insets. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Chip lọc khu: chọn một trong bốn; bỏ dấu tick vì nền mực đã đủ báo đang chọn. Vùng chạm vẫn 48dp (mặc định của Chip). -->
    <style name="Widget.MidtermProject.Chip.Filter" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_filter_background</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textSize">14sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
    </style>

    <!-- Ô tìm kiếm dạng viên thuốc: nền xám xanh nhạt, viền đổi sang mực khi đang gõ. Gợi ý nằm trong ô, không nổi lên. -->
    <style name="Widget.MidtermProject.SearchField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/chip_available_bg</item>
        <item name="boxCornerRadiusTopStart">24dp</item>
        <item name="boxCornerRadiusTopEnd">24dp</item>
        <item name="boxCornerRadiusBottomStart">24dp</item>
        <item name="boxCornerRadiusBottomEnd">24dp</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="startIconTint">@color/sheet_text_secondary</item>
        <item name="endIconTint">@color/sheet_text_secondary</item>
    </style>

    <!-- Nút "Giá": giống chip lọc (viên thuốc xám xanh, mực khi đang mở) nhưng bật tắt riêng, không thuộc nhóm chọn một. -->
    <style name="Widget.MidtermProject.Button.Filter" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:checkable">true</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textSize">14sp</item>
        <item name="backgroundTint">@color/chip_filter_background</item>
        <item name="iconTint">@color/chip_filter_text</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <!-- Nút chữ trong thẻ nổi ("Xóa lọc"): màu mực theo colorPrimary, chữ thường, vùng chạm cao 48dp. -->
    <style name="Widget.MidtermProject.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Công tắc màu mực: màu phụ của giao diện là tím VIP, dễ nhầm với khu VIP. -->
    <style name="ThemeOverlay.MidtermProject.InkSwitch" parent="">
        <item name="colorSecondary">@color/spot_selected</item>
    </style>
</resources>
