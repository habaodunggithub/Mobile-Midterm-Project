<resources>
    <!-- Kích thước bảng chú thích; bản ngang (values-land) nhỏ hơn để thẻ thấp, che ít sơ đồ (AC-1.4). -->
    <dimen name="legend_item_min_height">28dp</dimen>
    <dimen name="legend_card_padding">8dp</dimen>
    <!-- Bảng chi tiết rộng tối đa 420dp; chỉ bố cục ngang dùng giá trị này (Q40), bố cục dọc để bảng rộng hết chiều ngang. -->
    <dimen name="sheet_max_width">420dp</dimen>
    <!-- Bảng chi tiết nổi như miếng sticker, cách hai mép 10dp (Q42). -->
    <dimen name="sheet_side_margin">10dp</dimen>
    <!-- Viên thuốc tóm tắt cách mép phải và đáy (cộng thêm thanh điều hướng) 24dp (Q47). -->
    <dimen name="pill_margin">24dp</dimen>
    <!-- Miếng sticker quanh sơ đồ (Q42): cách mép khung 8dp, viền cam dày 16dp. Sơ đồ lùi vào 16dp (giữa viền),
         nên mép sơ đồ nằm khuất dưới viền. -->
    <dimen name="sticker_margin">8dp</dimen>
    <dimen name="sticker_band">16dp</dimen>
    <dimen name="sticker_map_inset">16dp</dimen>
    <!-- Nút nổi và thẻ nổi nằm bên trong viền: 8dp lề + 16dp viền + 6dp khoảng hở. -->
    <dimen name="sticker_content_margin">30dp</dimen>
    <!-- Thẻ nổi phía trên sơ đồ chừa chỗ cho cột nút: 30dp + nút 48dp + 8dp khoảng hở. -->
    <dimen name="sticker_overlay_end_margin">86dp</dimen>
</resources>
