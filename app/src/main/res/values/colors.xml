<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hướng thiết kế G "Poster lỏng" (REQUIREMENTS Q42). Mỗi cặp màu nền/ký hiệu đã được kiểm tương phản:
         chữ >= 4,5:1; hình và ký hiệu có nghĩa >= 3:1 so với màu kề nó. Nền trong sticker sơ đồ là kem. -->

    <!-- Poster phủ cả màn hình: nền hồng sen và ba màu dải lỏng -->
    <color name="poster_background">#FFFF1493</color>
    <color name="liquid_orange">#FFFF6A00</color>
    <color name="liquid_green">#FF0B7A2A</color>
    <color name="liquid_violet">#FF5B1BFF</color>

    <!-- Viền sticker quanh sơ đồ -->
    <color name="sticker_band">#FFFF6A00</color>
    <color name="sticker_outline">#FF5B1BFF</color>

    <!-- Nền và chữ trên sơ đồ -->
    <color name="map_background">#FFFFF3E4</color>
    <color name="stage_fill">#FF0B7A2A</color>
    <color name="stage_stroke">#FFFF6A00</color>
    <color name="stage_text">#FFFFF3E4</color>
    <color name="label_text">#FF2A0A5E</color>
    <color name="label_halo">#FFFFF3E4</color>

    <!-- Ba khu: màu nền chỗ và màu chữ trên chỗ. Không viền (mẫu G): cam 3,3:1, tím 9,6:1, hồng 4,2:1 trên nền kem -->
    <color name="zone_standing">#FFFF6A00</color>
    <color name="on_zone_standing">#FF2A0A5E</color>
    <color name="zone_vip">#FF5B1BFF</color>
    <color name="on_zone_vip">#FFFFFFFF</color>
    <color name="zone_standard">#FFE0137A</color>
    <color name="on_zone_standard">#FFFFFFFF</color>

    <!-- Các trạng thái hiển thị còn lại -->
    <color name="spot_selected">#FF2A0A5E</color>
    <color name="on_spot_selected">#FFFFF3E4</color>
    <color name="spot_mine">#FF0B7A2A</color>
    <color name="on_spot_mine">#FFFFF3E4</color>
    <color name="spot_booked">#FFF1D9C8</color>
    <color name="on_spot_booked">#FF8A5A55</color>
    <color name="spot_locked_fill">#FFFFF3E4</color>
    <color name="spot_locked_stroke">#FF5A3A50</color>

    <!-- Nút nổi và các thẻ sticker -->
    <color name="surface">#FFFFF3E4</color>
    <color name="compass_needle">#FF2A0A5E</color>
    <color name="compass_tail">#FFB9A3C9</color>
    <color name="map_button_icon">#FF5B1BFF</color>

    <!-- Viền ô tìm kiếm khi nghỉ: tím, tương phản >= 3:1 với nền kem -->
    <color name="field_stroke_idle">#FF5B1BFF</color>

    <!-- Màu trung tính cho mẫu "ghế tròn" và "ô đứng vuông" trong bảng chú thích (tương phản >= 3:1 trên nền kem) -->
    <color name="legend_shape">#FF8A6E7E</color>

    <!-- Bảng chi tiết: nền kem, chữ mực tím; mỗi chip trạng thái là một cặp nền/chữ đạt tương phản >= 4,5:1 -->
    <color name="sheet_text">#FF2A0A5E</color>
    <color name="sheet_text_secondary">#FF5E4A6E</color>
    <color name="sheet_handle">#FFFF6A00</color>
    <color name="chip_available_bg">#FFF6E3D3</color>
    <color name="chip_available_fg">#FF2A0A5E</color>
    <color name="chip_selected_bg">#FF5B1BFF</color>
    <color name="chip_selected_fg">#FFFFF3E4</color>
    <!-- Chip trạng thái "Đang chọn" trong bảng chi tiết: màu mực như mẫu G (chip lọc đang chọn thì tím) -->
    <color name="state_selected_bg">#FF2A0A5E</color>
    <color name="state_selected_fg">#FFFFF3E4</color>
    <color name="chip_mine_bg">#FFCDEBD3</color>
    <color name="chip_mine_fg">#FF0B5D1E</color>
    <color name="chip_unavailable_bg">#FFEFE0D6</color>
    <color name="chip_unavailable_fg">#FF5A3A50</color>

    <!-- Vòng đánh dấu chỗ đang xem: viền kem bên dưới, vòng mực bên trên để thấy trên mọi màu -->
    <color name="focus_ring_halo">#FFFFF3E4</color>
    <color name="focus_ring">#FF2A0A5E</color>
</resources>
